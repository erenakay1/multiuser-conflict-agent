# Kopyala: cp .env.example .env   (.env asla commit edilmez)

# ollama (geliştirme, varsayılan) | openai (deneyler)
LLM_PROVIDER=ollama

# Yalnızca LLM_PROVIDER=openai iken gerekli
OPENAI_API_KEY=

# Ollama'nın OpenAI uyumlu uç noktası
OLLAMA_BASE_URL=http://localhost:11434/v1

# Geliştirmede kullanılan yerel model (ollama pull <model>)
DEV_MODEL=llama3.1:8b

# Deneylerde kullanılan API modeli
EXPERIMENT_MODEL=gpt-4o-mini
